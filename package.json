{
  "name": "schemacanvas",
  "private": true,
  "version": "0.1.0",
  "description": "SchemaCanvas - browser-based database diagramming and modeling studio (Chen ER, horizontal relational schemas, Crow's Foot, SQL).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && vitest run && vite build",
    "e2e:all": "playwright test",
    "e2e:perf": "playwright test -c e2e/perf/playwright.perf.config.ts --output=.tmp/perf/results",
    "analyze": "node scripts/bundle-size.mjs",
    "serve:dist": "node scripts/serve-static.mjs dist 4173 /schemacanvas/",
    "docs:shortcuts": "node scripts/gen-shortcuts.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "e2e:cross": "playwright test -c playwright.cross.config.ts",
    "notices": "node scripts/gen-notices.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "release:build": "npm run notices && npm run build && npm run check:dist",
    "release:manifest": "node scripts/release-manifest.mjs write",
    "release:verify": "node scripts/release-manifest.mjs verify"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "elkjs": "^0.12.0",
    "immer": "^11.1.21",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  }
}
