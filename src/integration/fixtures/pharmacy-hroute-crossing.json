kind":"relationship","id":"rel_go003sjtp3"},"targets":[{"kind":"relation","id":"rln_6lobx6bfr9"},{"kind":"foreignKey","id":"fk_wykmaenmws"},{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_yxgwidurw1"},{"kind":"foreignKey","id":"fk_qkzqylltue"},{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_iakovtz6bx"},{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_ijkpcisfh1"},{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_3fd63gf2mx"}],"ruleId":"many-to-many-relation"},{"source":{"kind":"relationship","id":"rel_w12oii562f"},"targets":[{"kind":"relation","id":"rln_wyyq92vjqr"},{"kind":"foreignKey","id":"fk_8lavi2430u"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_ksxkb3wfi4"},{"kind":"foreignKey","id":"fk_y2zyxqfhev"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_m2z1rc4rtz"},{"kind":"foreignKey","id":"fk_u3yihrgdia"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_jqzow1vvqh"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_xz4oz10w0o"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_eow6dowv6f"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_cf5w5rsmtg"}],"ruleId":"n-ary-relation"},{"source":{"kind":"relationship","id":"rel_yde66tq3dm"},"targets":[{"kind":"relation","id":"rln_cnlk5wdcie"},{"kind":"foreignKey","id":"fk_enko1yts5n"},{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_v1tgsxgegt"},{"kind":"foreignKey","id":"fk_4l0qbw24ld"},{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_vpcfl2fv2f"},{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_t3z0uasw1x"},{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_i8bkfr73ek"}],"ruleId":"many-to-many-relation"}],"decisions":[{"id":"weak-entity|ent_7ekzd0wgzl","ruleId":"weak-entity","title":"Weak entity Drug: key = owner key + partial key","explanation":"Drug cannot be identified by its own attributes, so its primary key is the FULL primary key of Company (CompanyName) plus its partial key TradeName: primary key (CompanyName, TradeName). The identifying relationship creates no table of its own; it is the foreign key from Drug to Company.","sources":[{"kind":"entity","id":"ent_7ekzd0wgzl"}],"targets":[{"kind":"relation","id":"rln_c64l2ku0sz"},{"kind":"column","relationId":"rln_c64l2ku0sz","id":"col_y8i0ja8gts"}],"level":"info"},{"id":"relationship-attribute|rel_go003sjtp3","ruleId":"relationship-attribute","title":"Attributes of Contract stored in Contract","explanation":"(StartDate, EndDate) describe the relationship Contract, so they were placed in Contract. Relationship attributes are never dropped.","sources":[{"kind":"attribute","id":"att_kw3cji8e43"},{"kind":"attribute","id":"att_8suo19bsoo"}],"targets":[{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_ijkpcisfh1"},{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_3fd63gf2mx"}],"level":"info"},{"id":"many-to-many-relation|rel_go003sjtp3","ruleId":"many-to-many-relation","title":"Contract becomes relation Contract","explanation":"Contract (M:N) is represented by its own relation Contract with one foreign key per participant (Pharmacy, Company). Its primary key (PharmacyName, CompanyName) comes from the key participants Pharmacy, Company.","sources":[{"kind":"relationship","id":"rel_go003sjtp3"}],"targets":[{"kind":"relation","id":"rln_6lobx6bfr9"},{"kind":"foreignKey","id":"fk_wykmaenmws"},{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_yxgwidurw1"},{"kind":"foreignKey","id":"fk_qkzqylltue"},{"kind":"column","relationId":"rln_6lobx6bfr9","id":"col_iakovtz6bx"}],"level":"info"},{"id":"weak-entity-owner-key|rel_2rb2orwz3w","ruleId":"weak-entity-owner-key","title":"Identifying relationship Makes creates no table","explanation":"Makes identifies Drug. It is represented by the owner key columns inside Drug and the foreign key to the owner; a separate relation would only duplicate that information.","sources":[{"kind":"relationship","id":"rel_2rb2orwz3w"}],"targets":[{"kind":"relation","id":"rln_c64l2ku0sz"},{"kind":"foreignKey","id":"fk_cefvfo1zvp"}],"level":"info"},{"id":"relationship-attribute|rel_w12oii562f","ruleId":"relationship-attribute","title":"Attributes of Prescription stored in Prescription","explanation":"(Date, Quantity) describe the relationship Prescription, so they were placed in Prescription. Relationship attributes are never dropped.","sources":[{"kind":"attribute","id":"att_9t9ln4ze2i"},{"kind":"attribute","id":"att_dz6p37f5s3"}],"targets":[{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_eow6dowv6f"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_cf5w5rsmtg"}],"level":"info"},{"id":"n-ary-relation|rel_w12oii562f","ruleId":"n-ary-relation","title":"Prescription becomes relation Prescription","explanation":"Prescription (n-ary) is represented by its own relation Prescription with one foreign key per participant (Doctor, Patient, Drug). Its primary key (DoctorSSN, PatientSSN, CompanyName, DrugTradeName, Date) comes from the key participants Doctor, Patient, Drug plus the key attribute Date; it is not automatically all foreign keys but follows the cardinalities.","sources":[{"kind":"relationship","id":"rel_w12oii562f"}],"targets":[{"kind":"relation","id":"rln_wyyq92vjqr"},{"kind":"foreignKey","id":"fk_8lavi2430u"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_ksxkb3wfi4"},{"kind":"foreignKey","id":"fk_y2zyxqfhev"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_m2z1rc4rtz"},{"kind":"foreignKey","id":"fk_u3yihrgdia"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_jqzow1vvqh"},{"kind":"column","relationId":"rln_wyyq92vjqr","id":"col_xz4oz10w0o"}],"level":"info"},{"id":"one-to-many-fk|rel_69sz0qo77b","ruleId":"one-to-many-fk","title":"PrimaryPhysician: foreign key on the N side (Patient)","explanation":"In PrimaryPhysician each Patient relates to at most one Doctor, so the key of the \"one\" side (Doctor) was copied into the \"many\" side (Patient) as foreign key Patient.DoctorSSN → Doctor.SSN; the reverse would require a multi-valued column. The column is NOT NULL because Patient participates totally.","sources":[{"kind":"relationship","id":"rel_69sz0qo77b"}],"targets":[{"kind":"foreignKey","id":"fk_h8556zsw6o"},{"kind":"column","relationId":"rln_szfx8bn4m4","id":"col_jgmjt3ef5d"}],"level":"info"},{"id":"relationship-attribute|rel_yde66tq3dm","ruleId":"relationship-attribute","title":"Attributes of Sell stored in Sell","explanation":"Price describes the relationship Sell, so it was placed in Sell. Relationship attributes are never dropped.","sources":[{"kind":"attribute","id":"att_oha94z83v1"}],"targets":[{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_i8bkfr73ek"}],"level":"info"},{"id":"many-to-many-relation|rel_yde66tq3dm","ruleId":"many-to-many-relation","title":"Sell becomes relation Sell","explanation":"Sell (M:N) is represented by its own relation Sell with one foreign key per participant (Pharmacy, Drug). Its primary key (PharmacyName, CompanyName, DrugTradeName) comes from the key participants Pharmacy, Drug.","sources":[{"kind":"relationship","id":"rel_yde66tq3dm"}],"targets":[{"kind":"relation","id":"rln_cnlk5wdcie"},{"kind":"foreignKey","id":"fk_enko1yts5n"},{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_v1tgsxgegt"},{"kind":"foreignKey","id":"fk_4l0qbw24ld"},{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_vpcfl2fv2f"},{"kind":"column","relationId":"rln_cnlk5wdcie","id":"col_t3z0uasw1x"}],"level":"info"}],"warnings":[]}},"settings":{"defaultDialect":"generic"}},"er":"dgm_jnrva68zrd","rel":"dgm_7rrnatr92b"}